<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-free core: domain, ports and pure logic. Must never reference WPF,
       NAudio, Whisper.net, LLamaSharp or any Windows-only API, so that
       Quill.Core.Tests runs on macOS and Linux. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Quill.Core</RootNamespace>
    <AssemblyName>Quill.Core</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Built-in summary templates, read by Templates/DefaultTemplates.cs. -->
    <EmbeddedResource Include="Templates/Defaults/*.md" LogicalName="Quill.Core.Templates.Defaults.%(Filename)%(Extension)" />
    <!-- In-app AI-pack download catalog, read by AiPack/Download/AiPackCatalog.cs. -->
    <EmbeddedResource Include="AiPack/Download/ai-pack.catalog.json" LogicalName="Quill.Core.AiPack.Download.ai-pack.catalog.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Windows app assembly is named "quill". -->
    <InternalsVisibleTo Include="quill" />
    <InternalsVisibleTo Include="Quill.Windows.Tests" />
    <InternalsVisibleTo Include="Quill.Core.Tests" />
  </ItemGroup>
</Project>
