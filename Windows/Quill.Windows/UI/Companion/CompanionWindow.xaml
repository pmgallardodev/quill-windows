<ui:FluentWindow x:Class="Quill.Windows.UI.Companion.CompanionWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:qc="clr-namespace:Quill.Windows.UI.Theme.Controls"
                 xmlns:loc="clr-namespace:Quill.Windows.Resources"
                 xmlns:local="clr-namespace:Quill.Windows.UI.Companion"
                 Title="{loc:Str Companion_Title}"
                 Width="360"
                 Height="620"
                 Topmost="True"
                 ShowActivated="False"
                 ShowInTaskbar="False"
                 ResizeMode="NoResize"
                 WindowStartupLocation="Manual"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round"
                 FontFamily="{StaticResource Quill.Font.Text}"
                 FontSize="{StaticResource Quill.FontSize.Body}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <local:CompanionInverseVisibilityConverter x:Key="Hidden" />
        <local:SummaryItemGlyphConverter x:Key="Glyph" />

        <!-- One live summary item: glyph, text, optional detail, cited time. -->
        <DataTemplate x:Key="SummaryItemTemplate" DataType="{x:Type local:SummaryItem}">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Kind, Converter={StaticResource Glyph}}"
                           Foreground="{DynamicResource Quill.Brush.Ai}"
                           FontWeight="SemiBold" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}"
                               Style="{StaticResource Quill.Text.Caption}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
                </StackPanel>
                <qc:TimestampLink Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Top" Time="{Binding At}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="SectionList" TargetType="ItemsControl">
            <Setter Property="ItemTemplate" Value="{StaticResource SummaryItemTemplate}" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style x:Key="BannerBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Quill.Brush.AiSubtle}" />
            <Setter Property="CornerRadius" Value="{StaticResource Quill.Radius.Medium}" />
            <Setter Property="Padding" Value="{StaticResource Quill.Padding.CardCompact}" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBannerAttention}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Quill.Brush.WarningSubtle}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Collapsed: pill with recording dot, timer and both meters. Click expands, drag moves. -->
        <Border x:Name="Pill"
                Visibility="{Binding IsCollapsed, Converter={StaticResource Visible}}"
                Padding="12,8"
                Cursor="Hand"
                Background="Transparent"
                MouseLeftButtonDown="OnPillMouseLeftButtonDown"
                ToolTip="{loc:Str Action_Expand}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <qc:StatusPill Status="{Binding Status}" Text="{Binding ElapsedLabel}" VerticalAlignment="Center" />
                <ui:SymbolIcon Symbol="Mic24" FontSize="14" Margin="10,0,4,0"
                               Visibility="{Binding HasMicrophoneLevel, Converter={StaticResource Visible}}" />
                <qc:LevelMeter Level="{Binding MicrophoneLevel}" Width="36" VerticalAlignment="Center"
                               Visibility="{Binding HasMicrophoneLevel, Converter={StaticResource Visible}}" />
                <ui:SymbolIcon Symbol="Speaker224" FontSize="14" Margin="10,0,4,0"
                               Visibility="{Binding HasSystemLevel, Converter={StaticResource Visible}}" />
                <qc:LevelMeter Level="{Binding SystemLevel}" Width="36" VerticalAlignment="Center"
                               Visibility="{Binding HasSystemLevel, Converter={StaticResource Visible}}" />
            </StackPanel>
        </Border>

        <!-- Expanded panel -->
        <DockPanel Visibility="{Binding IsCollapsed, Converter={StaticResource Hidden}}" LastChildFill="True">

            <!-- Header: status, timer, meters, pause/resume, stop, collapse. Drag to move. -->
            <Border DockPanel.Dock="Top"
                    Padding="12,10,8,8"
                    Background="Transparent"
                    MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <qc:StatusPill Status="{Binding Status}" Text="{Binding ElapsedLabel}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                        <ui:SymbolIcon Symbol="Mic24" FontSize="14" Margin="0,0,4,0"
                                       ToolTip="{loc:Str Companion_Microphone}"
                                       Visibility="{Binding HasMicrophoneLevel, Converter={StaticResource Visible}}" />
                        <qc:LevelMeter Level="{Binding MicrophoneLevel}" Width="32" VerticalAlignment="Center"
                                       ToolTip="{loc:Str Companion_Microphone}"
                                       Visibility="{Binding HasMicrophoneLevel, Converter={StaticResource Visible}}" />
                        <ui:SymbolIcon Symbol="Speaker224" FontSize="14" Margin="8,0,4,0"
                                       ToolTip="{loc:Str Companion_SystemAudio}"
                                       Visibility="{Binding HasSystemLevel, Converter={StaticResource Visible}}" />
                        <qc:LevelMeter Level="{Binding SystemLevel}" Width="32" VerticalAlignment="Center"
                                       ToolTip="{loc:Str Companion_SystemAudio}"
                                       Visibility="{Binding HasSystemLevel, Converter={StaticResource Visible}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ui:Button Appearance="Transparent" Padding="6"
                                   Command="{Binding TogglePauseCommand}"
                                   ToolTip="{Binding PauseLabel}"
                                   AutomationProperties.Name="{Binding PauseLabel}">
                            <Grid>
                                <ui:SymbolIcon Symbol="Pause24" Visibility="{Binding IsPaused, Converter={StaticResource Hidden}}" />
                                <ui:SymbolIcon Symbol="Play24" Visibility="{Binding IsPaused, Converter={StaticResource Visible}}" />
                            </Grid>
                        </ui:Button>
                        <ui:Button Appearance="Transparent" Padding="6"
                                   Command="{Binding StopCommand}"
                                   ToolTip="{loc:Str Action_StopRecording}"
                                   AutomationProperties.Name="{loc:Str Action_StopRecording}">
                            <ui:SymbolIcon Symbol="Stop24" Foreground="{DynamicResource Quill.Brush.Recording}" />
                        </ui:Button>
                        <ui:Button Appearance="Transparent" Padding="6"
                                   Command="{Binding ToggleCollapsedCommand}"
                                   ToolTip="{loc:Str Action_Collapse}"
                                   AutomationProperties.Name="{loc:Str Action_Collapse}">
                            <ui:SymbolIcon Symbol="Subtract24" />
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Footer: catch-up and marker, toast, quick note and recording notice. -->
            <StackPanel DockPanel.Dock="Bottom" Margin="12,4,12,12">
                <Border Visibility="{Binding HasToast, Converter={StaticResource Visible}}"
                        Background="{DynamicResource Quill.Brush.NeutralSubtle}"
                        CornerRadius="{StaticResource Quill.Radius.Small}"
                        Padding="8,4" Margin="0,0,0,8">
                    <TextBlock Text="{Binding Toast}" Style="{StaticResource Quill.Text.Caption}" TextWrapping="Wrap" />
                </Border>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Appearance="Primary" HorizontalAlignment="Stretch"
                               Icon="{ui:SymbolIcon Flash24}"
                               Content="{loc:Str Action_WhatDidIMiss}"
                               Command="{Binding WhatDidIMissCommand}" />
                    <ui:Button Grid.Column="2"
                               Icon="{ui:SymbolIcon Pin24}"
                               Content="{loc:Str Companion_Mark}"
                               ToolTip="{loc:Str Action_AddMarker}"
                               Command="{Binding MarkCommand}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox PlaceholderText="{loc:Str Companion_Notes_Placeholder}"
                                Icon="{ui:SymbolIcon Note24}"
                                Text="{Binding QuickNoteText, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding IsNotesEditable}"
                                AutomationProperties.Name="{loc:Str Action_AddNote}">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddQuickNoteCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                    <ui:Button Grid.Column="1" Appearance="Transparent" Padding="6" Margin="4,0,0,0"
                               Command="{Binding CopyNoticeCommand}"
                               ToolTip="{loc:Str Companion_Notice_Tooltip}"
                               AutomationProperties.Name="{loc:Str Companion_Notice_Button}">
                        <ui:SymbolIcon Symbol="Megaphone24" />
                    </ui:Button>
                </Grid>
            </StackPanel>

            <!-- Tabs, with the catch-up card floating above them. -->
            <Grid Margin="8,0,8,0">
                <TabControl SelectedIndex="{Binding SelectedTab}">
                    <TabItem Header="{loc:Str Companion_Tab_Live}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,4,0">
                            <StackPanel>
                                <Border Style="{StaticResource BannerBorder}"
                                        Visibility="{Binding HasBanner, Converter={StaticResource Visible}}">
                                    <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" Style="{StaticResource Quill.Text.Caption}" />
                                </Border>

                                <qc:Card Margin="0,0,0,8">
                                    <StackPanel>
                                        <qc:SectionHeader Title="{loc:Str Summary_ExecutiveSummary}" />
                                        <TextBlock Text="{Binding SummaryView.ExecutiveSummary}" TextWrapping="Wrap"
                                                   Visibility="{Binding HasExecutiveSummary, Converter={StaticResource Visible}}" />
                                        <qc:EmptyState Visibility="{Binding HasExecutiveSummary, Converter={StaticResource Hidden}}" />
                                    </StackPanel>
                                </qc:Card>

                                <qc:Card Margin="0,0,0,8">
                                    <StackPanel>
                                        <qc:SectionHeader Title="{loc:Str Summary_Decisions}" Count="{Binding SummaryView.Decisions.Count}" />
                                        <ItemsControl Style="{StaticResource SectionList}" ItemsSource="{Binding SummaryView.Decisions}" />
                                        <qc:EmptyState Visibility="{Binding HasNoDecisions, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </qc:Card>

                                <qc:Card Margin="0,0,0,8">
                                    <StackPanel>
                                        <qc:SectionHeader Title="{loc:Str Summary_ActionItems}" Count="{Binding SummaryView.ActionItems.Count}" />
                                        <ItemsControl Style="{StaticResource SectionList}" ItemsSource="{Binding SummaryView.ActionItems}" />
                                        <qc:EmptyState Visibility="{Binding HasNoActionItems, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </qc:Card>

                                <qc:Card Margin="0,0,0,8">
                                    <StackPanel>
                                        <qc:SectionHeader Title="{loc:Str Summary_OpenQuestions}" Count="{Binding SummaryView.OpenQuestions.Count}" />
                                        <ItemsControl Style="{StaticResource SectionList}" ItemsSource="{Binding SummaryView.OpenQuestions}" />
                                        <qc:EmptyState Visibility="{Binding HasNoOpenQuestions, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </qc:Card>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="{loc:Str Companion_Tab_Transcript}">
                        <Grid Margin="0,8,0,0">
                            <ItemsControl x:Name="TranscriptList"
                                          ItemsSource="{Binding TranscriptRows}"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.ScrollUnit="Pixel"
                                          ScrollViewer.CanContentScroll="True"
                                          ScrollViewer.ScrollChanged="OnTranscriptScrollChanged"
                                          Visibility="{Binding HasLiveTranscript, Converter={StaticResource Visible}}">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:TranscriptRow}">
                                        <StackPanel Margin="4,0,4,10">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <qc:SpeakerChip SpeakerId="{Binding SpeakerId}" />
                                                <TextBlock Text="{Binding TimeLabel}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Style="{StaticResource Quill.Text.Caption}"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <qc:EmptyState Text="{loc:Str Companion_Transcript_Empty}"
                                           VerticalAlignment="Top"
                                           Visibility="{Binding IsTranscriptEmpty, Converter={StaticResource Visible}}" />
                            <qc:EmptyState Text="{loc:Str Companion_Transcript_Unavailable}"
                                           VerticalAlignment="Top"
                                           Visibility="{Binding HasLiveTranscript, Converter={StaticResource Hidden}}" />

                            <ui:Button x:Name="JumpToEnd"
                                       Visibility="Collapsed"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                       Icon="{ui:SymbolIcon ArrowDown24}"
                                       Content="{loc:Str Companion_Transcript_JumpToEnd}"
                                       Click="OnJumpToEndClick" />
                        </Grid>
                    </TabItem>

                    <TabItem Header="{loc:Str Companion_Tab_Notes}">
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Bottom" Margin="2,6,2,0"
                                       Text="{Binding NotesStatusText}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Quill.Text.Caption}">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNotesProblem}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Quill.Brush.Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Text="{Binding NotesText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsNotesEditable}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="{StaticResource Quill.Font.Mono}"
                                     AutomationProperties.Name="{loc:Str Companion_Tab_Notes}" />
                        </DockPanel>
                    </TabItem>
                </TabControl>

                <!-- "¿Qué me perdí?" card -->
                <Border Visibility="{Binding IsCatchUpVisible, Converter={StaticResource Visible}}"
                        VerticalAlignment="Top"
                        Margin="0,40,0,0"
                        MaxHeight="420"
                        Background="{DynamicResource ApplicationBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Quill.Radius.Large}"
                        Effect="{StaticResource Quill.Elevation.Flyout}">
                    <DockPanel Margin="12">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Padding="4"
                                       Command="{Binding CloseCatchUpCommand}"
                                       ToolTip="{loc:Str Action_Close}"
                                       AutomationProperties.Name="{loc:Str Action_Close}">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                            </ui:Button>
                            <ui:SymbolIcon Symbol="Flash24" Foreground="{DynamicResource Quill.Brush.Ai}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding CatchUpTitle}" Style="{StaticResource Quill.Text.BodyStrong}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding HasCatchUpMessage, Converter={StaticResource Visible}}">
                                    <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                                     Visibility="{Binding IsCatchUpLoading, Converter={StaticResource Visible}}" />
                                    <TextBlock Text="{Binding CatchUpMessage}" TextWrapping="Wrap" MaxWidth="280" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsCatchUpReady, Converter={StaticResource Visible}}">
                                    <TextBlock Text="{Binding CatchUpView.ExecutiveSummary}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <ItemsControl Style="{StaticResource SectionList}" ItemsSource="{Binding CatchUpView.Decisions}" />
                                    <ItemsControl Style="{StaticResource SectionList}" ItemsSource="{Binding CatchUpView.ActionItems}" />
                                    <ItemsControl Style="{StaticResource SectionList}" ItemsSource="{Binding CatchUpView.OpenQuestions}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
