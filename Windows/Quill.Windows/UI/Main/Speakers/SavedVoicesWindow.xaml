<ui:FluentWindow x:Class="Quill.Windows.UI.SavedVoicesWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:Quill.Windows.Resources"
                 xmlns:local="clr-namespace:Quill.Windows.UI"
                 x:ClassModifier="internal"
                 Title="{loc:Str Voices_SavedVoices}"
                 Width="560" Height="520" MinWidth="420" MinHeight="320"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource ApplicationBackgroundBrush}">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </ui:FluentWindow.Resources>

    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="{loc:Str Voices_SavedVoices}" />

        <StackPanel DockPanel.Dock="Top" Margin="{StaticResource Quill.Padding.Window}">
            <TextBlock Text="{loc:Str Voices_PrivacyNote}" Style="{StaticResource Quill.Text.Caption}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <CheckBox Margin="0,12,0,0" Content="{loc:Str Voices_AutoApply}" IsChecked="{Binding AutoApply, Mode=TwoWay}" />
            <TextBlock Margin="0,4,0,0" Text="{loc:Str Voices_AutoApplyHint}" Style="{StaticResource Quill.Text.Caption}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Margin="0,12,0,0" Text="{loc:Str Voices_Empty}" TextWrapping="Wrap"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Margin="0,8,0,0" Text="{Binding StatusText}" Style="{StaticResource Quill.Text.Caption}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer Margin="24,0,24,24" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Voices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:SavedVoiceRowViewModel}">
                        <Border Margin="0,0,0,8" Padding="{StaticResource Quill.Padding.CardCompact}"
                                CornerRadius="{StaticResource Quill.Radius.Medium}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Appearance="Transparent"
                                               ToolTip="{loc:Str Voices_Forget}"
                                               AutomationProperties.Name="{loc:Str Voices_Forget}"
                                               Command="{Binding ForgetCommand}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Delete24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Quill.Text.BodyStrong}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Quill.Text.Caption}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Margin="0,6,0,0" Visibility="{Binding IsNamed, Converter={StaticResource BoolToVisibility}}">
                                    <ui:Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="{loc:Str Voices_Rename}"
                                               Command="{Binding RenameCommand}" />
                                    <ui:TextBox Text="{Binding NameDraft, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{loc:Str Voices_Rename}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</ui:FluentWindow>
