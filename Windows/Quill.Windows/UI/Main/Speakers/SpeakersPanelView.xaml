<UserControl x:Class="Quill.Windows.UI.SpeakersPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Quill.Windows.Resources"
             xmlns:local="clr-namespace:Quill.Windows.UI"
             x:ClassModifier="internal">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <!-- Collapsed by default: naming people is optional and the panel stays out of the way. -->
    <Expander Margin="0,8,0,0" IsExpanded="False">
        <Expander.Header>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{loc:Str Voices_PanelTitle}" Style="{StaticResource Quill.Text.BodyStrong}" VerticalAlignment="Center" />
                <Border Margin="8,0,0,0" Padding="{StaticResource Quill.Padding.Chip}"
                        CornerRadius="{StaticResource Quill.Radius.Pill}"
                        Background="{DynamicResource Quill.Brush.InfoSubtle}"
                        Visibility="{Binding HasSuggestions, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{loc:Str Voices_SuggestionsBadge}" Style="{StaticResource Quill.Text.Caption}"
                               Foreground="{DynamicResource Quill.Brush.Info}" />
                </Border>
            </StackPanel>
        </Expander.Header>

        <StackPanel Margin="0,4,0,0">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Content="{loc:Str Voices_SavedVoices}"
                           Click="OnSavedVoicesClick">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="People24" />
                    </ui:Button.Icon>
                </ui:Button>
                <CheckBox Content="{loc:Str InPerson_Toggle}" ToolTip="{loc:Str InPerson_Hint}"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IsInPerson, Mode=TwoWay}"
                          IsEnabled="{Binding CanChangeInPerson}" />
            </DockPanel>

            <TextBlock Margin="0,4,0,0" Text="{loc:Str Voices_NoSpeakers}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Quill.Text.Caption}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSpeakers}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Speakers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:SpeakerRowViewModel}">
                        <StackPanel Margin="0,0,0,8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Width="120" VerticalAlignment="Center"
                                           Text="{Binding DefaultLabel}" Style="{StaticResource Quill.Text.Secondary}"
                                           TextTrimming="CharacterEllipsis" />
                                <ui:Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="{loc:Str Voices_SaveName}"
                                           Command="{Binding SaveNameCommand}" />
                                <ui:TextBox Text="{Binding NameDraft, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="{loc:Str Voices_NamePlaceholder}"
                                            AutomationProperties.Name="{Binding DefaultLabel}" />
                            </DockPanel>
                            <Border Margin="120,6,0,0" HorizontalAlignment="Left"
                                    Padding="{StaticResource Quill.Padding.CardCompact}"
                                    CornerRadius="{StaticResource Quill.Radius.Medium}"
                                    Background="{DynamicResource Quill.Brush.InfoSubtle}"
                                    Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SuggestionText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ui:Button Margin="0,0,4,0" Appearance="Primary" Content="{loc:Str Voices_Confirm}"
                                               Command="{Binding ConfirmCommand}" />
                                    <ui:Button Appearance="Secondary" Content="{loc:Str Voices_Reject}"
                                               Command="{Binding RejectCommand}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Quill.Text.Caption}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Expander>
</UserControl>
