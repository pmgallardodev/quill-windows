<UserControl x:Class="Quill.Windows.UI.AskPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Quill.Windows.Resources"
             xmlns:local="clr-namespace:Quill.Windows.UI"
             x:ClassModifier="internal">
    <!-- DataContext: AskViewModel (one meeting or every meeting). -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <DockPanel Margin="0,8,0,0">
        <DockPanel DockPanel.Dock="Top">
            <ui:Button DockPanel.Dock="Right" Margin="6,0,0,0" Appearance="Primary"
                       Content="{loc:Str Ask_Button}" Command="{Binding AskCommand}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Sparkle24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button DockPanel.Dock="Right" Margin="6,0,0,0" Appearance="Secondary"
                       Content="{loc:Str Ask_Cancel}" Command="{Binding CancelCommand}"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Stop24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:TextBox Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{Binding Placeholder}"
                        AutomationProperties.Name="{Binding Placeholder}"
                        IsEnabled="{Binding CanAsk}">
                <ui:TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AskCommand}" />
                </ui:TextBox.InputBindings>
            </ui:TextBox>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Margin="2,6,0,0" Text="{loc:Str Ask_Hint}" TextWrapping="Wrap"
                   Style="{StaticResource Quill.Text.Caption}"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

        <DockPanel DockPanel.Dock="Top" Margin="2,8,0,0"
                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
            <ui:ProgressRing DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,8,0" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Style="{StaticResource Quill.Text.Caption}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </DockPanel>

        <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="{StaticResource Quill.Padding.CardCompact}"
                        CornerRadius="{StaticResource Quill.Radius.Medium}"
                        Background="{DynamicResource Quill.Brush.AiSubtle}"
                        Visibility="{Binding HasAnswer, Converter={StaticResource BoolToVisibility}}">
                    <TextBox Text="{Binding Answer, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             BorderThickness="0" Background="Transparent" Padding="0"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             AutomationProperties.Name="{loc:Str Ask_AnswerLabel}" />
                </Border>

                <Border Margin="0,6,0,0" Padding="{StaticResource Quill.Padding.CardCompact}"
                        CornerRadius="{StaticResource Quill.Radius.Medium}"
                        Background="{DynamicResource Quill.Brush.WarningSubtle}"
                        Visibility="{Binding IsUngrounded, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <ui:SymbolIcon DockPanel.Dock="Left" Margin="0,0,8,0" Symbol="Warning24"
                                       Foreground="{DynamicResource Quill.Brush.Warning}" />
                        <TextBlock Text="{loc:Str Ask_Ungrounded}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <StackPanel Margin="0,10,0,0" Visibility="{Binding HasCitations, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{loc:Str Ask_Sources}" Style="{StaticResource Quill.Text.Caption}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Citations}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:AskCitationViewModel}">
                                <ui:Button Margin="0,0,6,6" Appearance="Secondary"
                                           Content="{Binding Label}" ToolTip="{Binding Quote}"
                                           AutomationProperties.Name="{Binding Label}"
                                           AutomationProperties.HelpText="{Binding Quote}"
                                           Command="{Binding OpenCommand}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Play24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
