<Window x:Class="Quill.Windows.UI.SessionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Quill.Windows.UI"
        x:ClassModifier="internal"
        Title="Sesiones de quill"
        Height="640" Width="920"
        MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="#FFFAFAFA">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBooleanToVisibilityConverter x:Key="NotToVisibility" />

        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF999999" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <!-- Buscador -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Limpiar" Padding="12,5" Margin="6,0,0,0"
                    Command="{Binding ClearSearchCommand}"
                    Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
            <Button DockPanel.Dock="Right" Content="Refrescar" Padding="12,5" Margin="6,0,0,0"
                    Click="OnRefresh" />
            <TextBox Padding="6,5" VerticalContentAlignment="Center"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                     ToolTip="Buscar en los transcripts de todas las sesiones" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Margin="2,10,0,0" Style="{StaticResource Secondary}"
                   Text="{Binding StatusText}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="300" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="3*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Lista de sesiones -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsSearching, Converter={StaticResource NotToVisibility}}">
                <ListBox ItemsSource="{Binding Sessions}"
                         SelectedItem="{Binding SelectedSession}"
                         BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#FFE0E0E0" BorderThickness="1"
                                    CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding StateGlyph}" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding StateText}" DockPanel.Dock="Right"
                                                   Foreground="#FF666666" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding IsNotEditingTitle, Converter={StaticResource BoolToVisibility}}" />
                                    </DockPanel>

                                    <!-- Renombrar en linea -->
                                    <TextBox Margin="22,4,0,0" Padding="4,3"
                                             Text="{Binding TitleDraft, UpdateSourceTrigger=PropertyChanged}"
                                             KeyDown="OnTitleKeyDown" LostFocus="OnTitleLostFocus"
                                             Visibility="{Binding IsEditingTitle, Converter={StaticResource BoolToVisibility}}" />

                                    <TextBlock Margin="22,2,0,0" Style="{StaticResource Secondary}"
                                               Text="{Binding FolderText}"
                                               Visibility="{Binding HasTitle, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Margin="22,2,0,0" Style="{StaticResource Secondary}"
                                               Text="{Binding DurationText}" />

                                    <!-- Progreso en vivo -->
                                    <StackPanel Margin="22,8,0,0"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="mic" Width="52" Foreground="#FF666666" FontSize="11" />
                                            <ProgressBar Value="{Binding MicProgress, Mode=OneWay}" Maximum="100" Height="8" />
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="system" Width="52" Foreground="#FF666666" FontSize="11" />
                                            <ProgressBar Value="{Binding SystemProgress, Mode=OneWay}" Maximum="100" Height="8" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding EtaText}" Style="{StaticResource Secondary}" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding ErrorText}" Foreground="#FFB00020" FontSize="11"
                                               TextWrapping="Wrap" Margin="22,6,0,0"
                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

                                    <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource Secondary}"
                                               Margin="22,6,0,0"
                                               Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}" />

                                    <WrapPanel Margin="22,8,0,0">
                                        <Button Content="Renombrar" Style="{StaticResource RowButton}"
                                                Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Abrir carpeta" Style="{StaticResource RowButton}"
                                                Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Directory}" />
                                         <Button Content="Copiar" Style="{StaticResource RowButton}"
                                                 Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}"
                                                 Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 CommandParameter="{Binding}" />
                                         <Button Content="SRT" Style="{StaticResource RowButton}"
                                                 Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}"
                                                 Command="{Binding DataContext.ExportSrtCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 CommandParameter="{Binding}" />
                                         <Button Content="VTT" Style="{StaticResource RowButton}"
                                                 Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}"
                                                 Command="{Binding DataContext.ExportVttCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 CommandParameter="{Binding}" />
                                        <Button Content="Reintentar" Style="{StaticResource RowButton}"
                                                Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Directory}" />
                                        <Button Content="Log" Style="{StaticResource RowButton}"
                                                Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.OpenLogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Directory}" />
                                        <Button Content="Borrar" Style="{StaticResource RowButton}"
                                                Foreground="#FFB00020"
                                                IsEnabled="{Binding CanDelete}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <!-- Resultados de busqueda, en el sitio de la lista -->
            <Border Grid.Column="0" Background="White" BorderBrush="#FFE0E0E0" BorderThickness="1"
                    CornerRadius="6" Padding="4"
                    Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="8,6,8,6" Style="{StaticResource Secondary}"
                               Text="{Binding SearchStatus}" />
                    <ListBox ItemsSource="{Binding SearchResults}" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <DockPanel>
                                        <TextBlock Text="{Binding TimeText}" DockPanel.Dock="Right"
                                                   Style="{StaticResource Secondary}" />
                                        <TextBlock Text="{Binding SessionLabel}" FontWeight="SemiBold" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2,0,0" FontSize="12" />
                                     <Button Content="Ir a la sesion" HorizontalAlignment="Left" Margin="0,4,0,0"
                                             Style="{StaticResource RowButton}"
                                             Command="{Binding DataContext.OpenHitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                             CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Lector de transcript -->
            <Border Grid.Column="2" Background="White" BorderBrush="#FFE0E0E0" BorderThickness="1"
                    CornerRadius="6" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ReaderTitle}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ReaderStatus}" Style="{StaticResource Secondary}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasReaderStatus, Converter={StaticResource BoolToVisibility}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ReaderLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <!-- Marca puesta durante la grabacion -->
                                        <Border Background="#FFFFF6E0" BorderBrush="#FFE8C86A" BorderThickness="1"
                                                CornerRadius="4" Padding="8,4"
                                                Visibility="{Binding IsMarker, Converter={StaticResource BoolToVisibility}}">
                                            <DockPanel>
                                                <TextBlock Text="{Binding TimeText}" Width="54"
                                                           Foreground="#FF8A6D1B" FontSize="11" />
                                                <TextBlock Text="{Binding Text}" Foreground="#FF8A6D1B"
                                                           FontSize="11" FontWeight="SemiBold" />
                                            </DockPanel>
                                        </Border>

                                        <DockPanel Visibility="{Binding IsSegment, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding TimeText}" Width="54" VerticalAlignment="Top"
                                                       Style="{StaticResource Secondary}" />
                                            <TextBlock Text="{Binding SpeakerText}" Width="54" VerticalAlignment="Top"
                                                       FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#FF7A5AF8" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMe}" Value="True">
                                                                <Setter Property="Foreground" Value="#FF0F766E" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
