<!--
  Quill semantic colors, light theme. ThemeBootstrapper swaps this dictionary with
  Colors.Dark.xaml when Windows changes theme, so always consume these keys through
  DynamicResource. Both files must define exactly the same keys.
  Each role has a strong color (text, dots, icons) and a Subtle tint (pill/chip background).
  Neutral surfaces, text and accent come from WPF-UI (see UI/Theme/README.md).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Quill.Color.Recording">#FFC42B1C</Color>
    <Color x:Key="Quill.Color.RecordingSubtle">#1FC42B1C</Color>
    <Color x:Key="Quill.Color.Me">#FF005FB8</Color>
    <Color x:Key="Quill.Color.MeSubtle">#1A005FB8</Color>
    <Color x:Key="Quill.Color.Success">#FF0F7B0F</Color>
    <Color x:Key="Quill.Color.SuccessSubtle">#1F0F7B0F</Color>
    <Color x:Key="Quill.Color.Warning">#FF9D5D00</Color>
    <Color x:Key="Quill.Color.WarningSubtle">#26F7B500</Color>
    <Color x:Key="Quill.Color.Info">#FF005FB8</Color>
    <Color x:Key="Quill.Color.InfoSubtle">#1A005FB8</Color>
    <Color x:Key="Quill.Color.Ai">#FF7A4FB5</Color>
    <Color x:Key="Quill.Color.AiSubtle">#1F7A4FB5</Color>
    <Color x:Key="Quill.Color.Neutral">#FF616161</Color>
    <Color x:Key="Quill.Color.NeutralSubtle">#14000000</Color>

    <!-- Audio level meter -->
    <Color x:Key="Quill.Color.MeterTrack">#14000000</Color>
    <Color x:Key="Quill.Color.MeterLow">#FF0F7B0F</Color>
    <Color x:Key="Quill.Color.MeterHigh">#FFC42B1C</Color>

    <!-- Speaker palette: 8 hues for "Speaker N". Blue and red stay reserved for Me/Recording. -->
    <Color x:Key="Quill.Color.Speaker1">#FFC25E00</Color>
    <Color x:Key="Quill.Color.Speaker2">#FF2E7D32</Color>
    <Color x:Key="Quill.Color.Speaker3">#FF7B4FC4</Color>
    <Color x:Key="Quill.Color.Speaker4">#FFC2357A</Color>
    <Color x:Key="Quill.Color.Speaker5">#FF00838F</Color>
    <Color x:Key="Quill.Color.Speaker6">#FF8A5A2B</Color>
    <Color x:Key="Quill.Color.Speaker7">#FF5E6B7D</Color>
    <Color x:Key="Quill.Color.Speaker8">#FF7A7A00</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="Quill.Brush.Recording" Color="{StaticResource Quill.Color.Recording}" />
    <SolidColorBrush x:Key="Quill.Brush.RecordingSubtle" Color="{StaticResource Quill.Color.RecordingSubtle}" />
    <SolidColorBrush x:Key="Quill.Brush.Me" Color="{StaticResource Quill.Color.Me}" />
    <SolidColorBrush x:Key="Quill.Brush.MeSubtle" Color="{StaticResource Quill.Color.MeSubtle}" />
    <SolidColorBrush x:Key="Quill.Brush.Success" Color="{StaticResource Quill.Color.Success}" />
    <SolidColorBrush x:Key="Quill.Brush.SuccessSubtle" Color="{StaticResource Quill.Color.SuccessSubtle}" />
    <SolidColorBrush x:Key="Quill.Brush.Warning" Color="{StaticResource Quill.Color.Warning}" />
    <SolidColorBrush x:Key="Quill.Brush.WarningSubtle" Color="{StaticResource Quill.Color.WarningSubtle}" />
    <SolidColorBrush x:Key="Quill.Brush.Info" Color="{StaticResource Quill.Color.Info}" />
    <SolidColorBrush x:Key="Quill.Brush.InfoSubtle" Color="{StaticResource Quill.Color.InfoSubtle}" />
    <SolidColorBrush x:Key="Quill.Brush.Ai" Color="{StaticResource Quill.Color.Ai}" />
    <SolidColorBrush x:Key="Quill.Brush.AiSubtle" Color="{StaticResource Quill.Color.AiSubtle}" />
    <SolidColorBrush x:Key="Quill.Brush.Neutral" Color="{StaticResource Quill.Color.Neutral}" />
    <SolidColorBrush x:Key="Quill.Brush.NeutralSubtle" Color="{StaticResource Quill.Color.NeutralSubtle}" />
    <SolidColorBrush x:Key="Quill.Brush.MeterTrack" Color="{StaticResource Quill.Color.MeterTrack}" />
    <SolidColorBrush x:Key="Quill.Brush.MeterLow" Color="{StaticResource Quill.Color.MeterLow}" />
    <SolidColorBrush x:Key="Quill.Brush.MeterHigh" Color="{StaticResource Quill.Color.MeterHigh}" />
    <SolidColorBrush x:Key="Quill.Brush.Speaker1" Color="{StaticResource Quill.Color.Speaker1}" />
    <SolidColorBrush x:Key="Quill.Brush.Speaker2" Color="{StaticResource Quill.Color.Speaker2}" />
    <SolidColorBrush x:Key="Quill.Brush.Speaker3" Color="{StaticResource Quill.Color.Speaker3}" />
    <SolidColorBrush x:Key="Quill.Brush.Speaker4" Color="{StaticResource Quill.Color.Speaker4}" />
    <SolidColorBrush x:Key="Quill.Brush.Speaker5" Color="{StaticResource Quill.Color.Speaker5}" />
    <SolidColorBrush x:Key="Quill.Brush.Speaker6" Color="{StaticResource Quill.Color.Speaker6}" />
    <SolidColorBrush x:Key="Quill.Brush.Speaker7" Color="{StaticResource Quill.Color.Speaker7}" />
    <SolidColorBrush x:Key="Quill.Brush.Speaker8" Color="{StaticResource Quill.Color.Speaker8}" />
</ResourceDictionary>
