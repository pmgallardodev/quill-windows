<!--
  Default (implicit) styles for the Quill shared controls. Merged into Application.Resources
  by ThemeBootstrapper after the tokens and semantic colors, so every window gets them.
  Neutral surfaces and text use WPF-UI brushes; Quill.Brush.* come from Colors.Light/Dark.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:qc="clr-namespace:Quill.Windows.UI.Theme.Controls">

    <!-- Card -->
    <Style TargetType="qc:Card">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource Quill.Padding.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Quill.Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Quill.FontSize.Body}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="qc:Card">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Quill.Radius.Medium}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsInteractive" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsInteractive" Value="True">
                            <Setter Property="Cursor" Value="Hand" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SectionHeader -->
    <Style TargetType="qc:SectionHeader">
        <Setter Property="Margin" Value="{StaticResource Quill.Margin.SectionHeader}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="qc:SectionHeader">
                    <DockPanel LastChildFill="True">
                        <ContentPresenter DockPanel.Dock="Right"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Action}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Quill.Text.BodyStrong}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{TemplateBinding Title}" />
                            <Border x:Name="CountBadge"
                                    Margin="8,0,0,0"
                                    Padding="6,0"
                                    MinWidth="20"
                                    VerticalAlignment="Center"
                                    CornerRadius="{StaticResource Quill.Radius.Pill}"
                                    Background="{DynamicResource Quill.Brush.NeutralSubtle}">
                                <TextBlock Style="{StaticResource Quill.Text.Caption}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="NoWrap"
                                           Text="{Binding Count, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Border>
                        </StackPanel>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Count" Value="{x:Null}">
                            <Setter TargetName="CountBadge" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SpeakerChip -->
    <Style TargetType="qc:SpeakerChip">
        <Setter Property="Padding" Value="{StaticResource Quill.Padding.Chip}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Quill.Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Quill.FontSize.Caption}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="qc:SpeakerChip">
                    <Border Background="{TemplateBinding TintBrush}"
                            CornerRadius="{StaticResource Quill.Radius.Pill}"
                            Padding="{TemplateBinding Padding}"
                            ToolTip="{TemplateBinding SpeakerId}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8"
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center"
                                     Fill="{TemplateBinding SpeakerBrush}" />
                            <TextBlock VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{TemplateBinding DisplayLabel}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- StatusPill -->
    <Style TargetType="qc:StatusPill">
        <Setter Property="Padding" Value="{StaticResource Quill.Padding.Pill}" />
        <Setter Property="FontFamily" Value="{StaticResource Quill.Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Quill.FontSize.Caption}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="qc:StatusPill">
                    <Border Background="{TemplateBinding TintBrush}"
                            CornerRadius="{StaticResource Quill.Radius.Pill}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="Dot"
                                     Width="8" Height="8"
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center"
                                     Fill="{TemplateBinding AccentBrush}" />
                            <TextBlock VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{TemplateBinding AccentBrush}"
                                       Text="{TemplateBinding DisplayText}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPulsing" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="Pulse">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="Dot"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.35"
                                                         Duration="0:0:0.9">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Pulse" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- EmptyState -->
    <Style TargetType="qc:EmptyState">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="qc:EmptyState">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Quill.Text.Body}"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{TemplateBinding Text}" />
                        <TextBlock x:Name="DescriptionText"
                                   Style="{StaticResource Quill.Text.Caption}"
                                   Margin="0,4,0,0"
                                   Text="{TemplateBinding Description}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TimestampLink -->
    <Style TargetType="qc:TimestampLink">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Quill.Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Quill.FontSize.Caption}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="qc:TimestampLink">
                    <Border x:Name="Frame"
                            Padding="2,0"
                            Background="Transparent"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            CornerRadius="{StaticResource Quill.Radius.Small}">
                        <TextBlock x:Name="Label"
                                   Typography.NumeralAlignment="Tabular"
                                   Text="{TemplateBinding DisplayText}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Label" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- LevelMeter draws itself (see LevelMeter.cs); only layout defaults here. -->
    <Style TargetType="qc:LevelMeter">
        <Setter Property="Height" Value="4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
